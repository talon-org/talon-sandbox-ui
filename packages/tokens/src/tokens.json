{
  "_doc": "Programmatic mirror of tokens.css. Use this for code-gen, theme inspection, or design-tool sync. Values match the Ink (default · dark) theme; alternate themes only override the `accent` block plus, for iron/phosphor/teal, one conflicting status color.",
  "themes": {
    "_default": "ink",
    "list": ["ink", "onyx", "pewter", "iron", "phosphor", "indigo", "violet", "sky", "teal"],
    "selector": "data-theme on <html>; ink == no attribute"
  },
  "mode": {
    "default": "dark",
    "list": ["dark", "light"],
    "selector": "data-mode on <html>; dark == no attribute"
  },
  "density": {
    "default": "standard",
    "list": ["compact", "standard", "relaxed"],
    "selector": "data-density on <html>; standard == no attribute"
  },
  "font": {
    "default": "geist",
    "list": ["geist", "plex", "jetbrains", "system"],
    "selector": "data-font on <html>; geist == no attribute"
  },

  "ink_dark": {
    "surface": {
      "bg-0":     "#000000",
      "bg-1":     "#0a0a0b",
      "bg-2":     "#131316",
      "bg-3":     "#1d1d22",
      "bg-4":     "#2a2a30",
      "bg-input": "#0d0d0f",
      "bg-hover":  "rgba(255,255,255,0.03)",
      "bg-active": "rgba(255,255,255,0.06)"
    },
    "line": {
      "line-soft":     "rgba(255,255,255,0.05)",
      "line":          "rgba(255,255,255,0.08)",
      "line-strong":   "rgba(255,255,255,0.14)",
      "line-emphasis": "rgba(255,255,255,0.22)"
    },
    "text": {
      "fg-0": "#e8e6df",
      "fg-1": "#c8c6c0",
      "fg-2": "#86868a",
      "fg-3": "#56565a",
      "fg-4": "#38383d"
    },
    "accent": {
      "acc":          "#7d97ff",
      "acc-fg":       "#07080b",
      "acc-soft":     "rgba(125,151,255,0.12)",
      "acc-line":     "rgba(125,151,255,0.32)",
      "acc-strong":   "#9badff",
      "acc-dim":      "rgba(125,151,255,0.5)",
      "selection-bg": "rgba(125,151,255,0.22)"
    },
    "status": {
      "ok":      "#5fc99e",
      "warn":    "#f0a050",
      "err":     "#f06262",
      "info":    "#7dc8e0",
      "magenta": "#c89af0",
      "teal":    "#5fd4b8",
      "_soft_alpha": 0.14
    }
  },

  "alt_themes_dark_accent_only": {
    "onyx":     { "acc": "#e6cf4a", "acc-fg": "#0a0a0b", "note": "solar yellow · safety lab" },
    "pewter":   { "acc": "#b8d6f0", "acc-fg": "#0a0c10", "note": "glacier · cool-tinted surfaces too" },
    "iron":     { "acc": "#e85d4a", "acc-fg": "#f2ece0", "err_override": "#f598a8", "note": "ember red · warm-tinted surfaces" },
    "phosphor": { "acc": "#b6e63e", "acc-fg": "#07090a", "ok_override": "#5cd6c4", "note": "acid lime · slight green tint" },
    "indigo":   { "acc": "#8194f0", "acc-fg": "#0a0a0b" },
    "violet":   { "acc": "#b298f0", "acc-fg": "#0a0a0b" },
    "sky":      { "acc": "#5cb6ee", "acc-fg": "#0a0a0b" },
    "teal":     { "acc": "#56cbb8", "acc-fg": "#0a0a0b", "ok_override": "#8fc97a" }
  },

  "light_white_dominant": {
    "_note": "All light themes share white surfaces; only accent differs.",
    "surface": {
      "bg-0": "#f1f2f5", "bg-1": "#ffffff", "bg-2": "#ffffff",
      "bg-3": "#fafbfc", "bg-4": "#eef0f3", "bg-input": "#ffffff"
    },
    "text": {
      "fg-0": "#0a0c12", "fg-1": "#2a2d36", "fg-2": "#5f6371",
      "fg-3": "#888d99", "fg-4": "#b4b8c1"
    },
    "accent_per_theme": {
      "ink":      "#2b4dcc",
      "onyx":     "#8a6b14",
      "pewter":   "#4a7ab3",
      "iron":     "#c54128",
      "phosphor": "#5e8413",
      "indigo":   "#2347ee",
      "violet":   "#6839e0",
      "sky":      "#1f8be7",
      "teal":     "#26c4b1"
    },
    "status_darkened": {
      "ok": "#2f8a4d", "warn": "#b97515", "err": "#c4334e",
      "info": "#1b6f9b", "magenta": "#6e4ed1", "teal": "#0f8270"
    }
  },

  "typography": {
    "font-sans": "'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
    "font-mono": "'Geist Mono', 'SF Mono', ui-monospace, Menlo, Consolas, monospace",
    "scale": {
      "text-xs": "11px", "text-sm": "12px", "text-base": "13px",
      "text-md": "14px", "text-lg": "16px", "text-xl": "20px",
      "text-2xl": "24px", "text-3xl": "32px", "text-4xl": "44px"
    },
    "weights_allowed": [400, 500, 600, 700],
    "leading":    { "tight": 1.2, "snug": 1.4, "normal": 1.55 },
    "tracking":   { "tight": "-0.015em", "headline": "-0.025em", "normal": 0, "mono-caps": "0.08em" }
  },

  "spacing_4px_base": {
    "s-0": "0", "s-1": "2px", "s-2": "4px", "s-3": "6px", "s-4": "8px",
    "s-5": "12px", "s-6": "16px", "s-7": "20px", "s-8": "24px",
    "s-9": "32px", "s-10": "40px", "s-11": "48px", "s-12": "64px"
  },

  "density_metrics": {
    "compact":  { "row-h": "30px", "ctrl-h-md": "26px", "pad-card": "14px", "sidebar-w": "216px", "topbar-h": "42px" },
    "standard": { "row-h": "36px", "ctrl-h-md": "28px", "pad-card": "20px", "sidebar-w": "232px", "topbar-h": "48px" },
    "relaxed":  { "row-h": "44px", "ctrl-h-md": "32px", "pad-card": "28px", "sidebar-w": "248px", "topbar-h": "56px" }
  },

  "radius": {
    "r-1": "4px", "r-2": "6px", "r-3": "8px", "r-4": "12px",
    "r-5": "16px", "r-full": "999px"
  },

  "shadow_use_sparingly": {
    "shadow-1": "0 1px 0 rgba(0,0,0,0.4)",
    "shadow-2": "0 4px 12px rgba(0,0,0,0.4)",
    "shadow-3": "0 24px 60px rgba(0,0,0,0.6), 0 4px 16px rgba(0,0,0,0.35)"
  },

  "motion": {
    "dur-fast": "90ms", "dur-base": "160ms", "dur-slow": "280ms",
    "ease-out":    "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
  },

  "z_index": { "cmdk": 35, "drawer": 40, "dialog": 50, "toast": 60 },

  "sandbox_states": {
    "_doc": "Authoritative sandbox state set. Components must accept ONE of these literals.",
    "list": ["provisioning", "pulling-image", "running", "idle", "paused", "terminating", "failed", "evicted"],
    "to_badge_kind": {
      "provisioning":  "warn",
      "pulling-image": "warn",
      "running":       "ok",
      "idle":          "muted static",
      "paused":        "muted static",
      "terminating":   "warn",
      "failed":        "err static",
      "evicted":       "muted static"
    },
    "label_zh": {
      "provisioning":  "调度中",
      "pulling-image": "拉取镜像",
      "running":       "运行中",
      "idle":          "空闲",
      "paused":        "已暂停",
      "terminating":   "终止中",
      "failed":        "失败",
      "evicted":       "已驱逐"
    }
  }
}
